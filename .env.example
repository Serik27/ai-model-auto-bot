# Telegram Bot Token (отримати у @BotFather)
BOT_TOKEN=your_telegram_bot_token_here

# Google Gemini API Key (отримати безкоштовно на https://aistudio.google.com/)
# Можна вказати один або декілька ключів через кому для ротації при вичерпанні добового ліміту:
GEMINI_API_KEY=your_gemini_api_key_here

# Основна та резервна моделі генерації зображень
IMAGE_MODEL=gemini-nano-banana-2.1
FALLBACK_IMAGE_MODEL=gemini-3.1-flash-image

# Модель для генерації описів і хештегів (Gemini 3.8 Flash)
CAPTION_MODEL=gemini-3.8-flash

# Затримка між генераціями в секундах (для безкоштовного плану Gemini ліміт 2 RPM -> мінімум 32 сек)
RATE_LIMIT_DELAY=32

# Директорія для збереження профілів моделей і згенерованих фото
DATA_DIR=data
